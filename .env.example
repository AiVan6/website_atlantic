# Скопируйте в .env и задайте свои значения. Файл .env не коммитится.
# Значения в одинарных кавычках передаются как есть (без подстановки $).
DB_NAME=atlanticdb
DB_USERNAME=atlantic
DB_PASSWORD='change-me'
# Домен сайта для Caddy (HTTPS выпускается автоматически).
# DNS-записи A/AAAA домена и www.<домен> должны указывать на сервер, порты 80 и 443 — открыты.
# localhost — локальная проверка с самоподписанным сертификатом.
SITE_DOMAIN=localhost
# Порты на хосте (доступны только с 127.0.0.1)
SITE_PORT=8080
DB_PORT=5432
